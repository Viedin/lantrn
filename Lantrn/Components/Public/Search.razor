@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Diagnostics
@using Lantrn.Components.Search
@using Lantrn.Infra
@using Lantrn.Services

@inject SearchService Searcher
@inject SearchAssistant Assistant
@inject DocumentStore Documents
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Search> Log

<PageTitle>@(string.IsNullOrWhiteSpace(Q) ? "Search" : $"{Q} · Search")</PageTitle>

<div class="search-page @(IsLanding ? "is-landing" : "has-query")">
    @if (IsLanding)
    {
        <div class="search-hero">
            <img class="hero-logo" src="@Assets["logo.svg"]" alt="" />
            <h1>What are you <span class="hero-mark">looking for</span>?</h1>
            <p class="lead-text">
                Describe it in your own words. Passages are matched on meaning, and exact names or numbers count too.
            </p>
        </div>
    }

    <div class="search-top">
        <SearchBar @ref="searchBar" Value="@query" ValueChanged="OnQueryChangedAsync" Busy="busy" OnSubmit="SubmitSearchAsync" OnClear="ClearQuery"
                   Tags="availableTags" Collections="collectionNames" />
    </div>

    <SearchOptions Collections="collections" Labels="labels" Collection="collection?.Id" CollectionChanged="PickCollectionAsync"
                   @bind-Kind="kind" @bind-Limit="limit"
                   AvailableTags="availableTags" SelectedTags="selectedTags" OnToggleTag="ToggleTag" />

    @if (IsLanding)
    {
        <p class="search-shortcuts">
            <span><kbd>↑</kbd><kbd>↓</kbd> move through results</span>
            <span><kbd>Enter</kbd> open document</span>
            <span><kbd>Esc</kbd> back to search</span>
            <span><kbd>tag:</kbd><kbd>in:</kbd> filter by tag or collection</span>
        </p>
    }

    @if (filterError is not null)
    {
        <div class="alert alert-warning">@filterError</div>
    }

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (requestedCollectionMissing && collection is not null)
    {
        <div class="alert alert-warning">
            The collection in this link doesn't exist or is private, so '@labels[collection.Id]' is searched instead.
        </div>
    }

    @if (busy && hits is null)
    {
        <div class="results-layout">
            <ResultList />
            <PreviewPane />
        </div>
    }
    else if (hits is not null && searchedCollection is not null)
    {
        var searchedName = labels[searchedCollection.Id];
        @if (hits.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                <h2>No matches in '@searchedName'</h2>
                <p>
                    Nothing in this collection came close enough. Try different wording or clear the tag filter.
                    @if (searchedCollection.Allows(user, CollectionAccess.Contribute))
                    {
                        <text>You can also <a href="collections/@searchedCollection.Id">check what the collection holds</a>.</text>
                    }
                </p>
            </div>
        }
        else
        {
            @* Keyed by the results, so each search gets a fresh answer and preview cache. *@
            @if (citedCount > 0)
            {
                <AnswerPanel @key="hits" Query="@searchedQuery" Hits="hits" Sources="citedCount"
                             CollectionId="searchedCollection.Id" CollectionName="@searchedName"
                             Selected="selected" OnSelect="(int index) => Select(index)" />
            }

            <div class="results-layout">
                <ResultList Hits="hits" Snippets="snippets" Selected="selected" OnSelect="(int index) => Select(index)"
                            CollectionName="@searchedName" Tags="searchedTags" Kind="searchedKind" ScoreKind="scoreKind"
                            ElapsedMs="elapsedMs" CitedCount="citedCount" />

                @if (SelectedHit is { } current)
                {
                    <PreviewPane @key="hits" Hit="current" Index="selected"
                                 CollectionId="searchedCollection.Id" CollectionName="@searchedName"
                                 Open="previewOpen" Terms="terms" OnClose="() => previewOpen = false" />
                }
            </div>
        }
    }
</div>

@code {
    // The search lives in the URL, so going back from a document (or reloading) restores it.
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "collection")]
    public string? CollectionParameter { get; set; }

    [SupplyParameterFromQuery(Name = "tag")]
    public string[]? TagParameter { get; set; }

    [SupplyParameterFromQuery(Name = "limit")]
    public int? LimitParameter { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindParameter { get; set; }

    private string query = string.Empty;
    private CollectionSummary? collection;
    private int limit = SearchOptions.DefaultLimit;
    private DocumentKind? kind;

    private IReadOnlyList<CollectionSummary> collections = [];
    private Dictionary<Guid, string> labels = [];
    private IReadOnlyList<string> collectionNames = [];
    private IReadOnlyList<string> availableTags = [];
    private Guid? tagsCollection;
    private HashSet<string> selectedTags = [];

    // What the shown results were searched with; the controls above may have moved on since.
    private string searchedQuery = string.Empty;
    private CollectionSummary? searchedCollection;
    private IReadOnlyList<string> searchedTags = [];
    private DocumentKind? searchedKind;

    private IReadOnlyList<SearchHit>? hits;
    private IReadOnlyList<MarkupString> snippets = [];
    private string[] terms = [];
    private ScoreKind scoreKind;
    private string? error;
    private string? filterError;
    private bool busy;
    private long elapsedMs;
    private string? lastSearchUri;

    // How many of the top hits the assistant answers from; 0 when it is off.
    private int citedCount;

    // The selected hit drives the preview; on narrow screens the preview is a sheet that opens only when asked.
    private int selected = -1;
    private bool previewOpen;

    private SearchBar? searchBar;
    private IJSObjectReference? module;
    private DotNetObjectReference<Search>? selfReference;
    private bool revealPending;

    private bool IsLanding => string.IsNullOrWhiteSpace(Q) && hits is null && !busy && error is null;

    // A link can name a collection that was deleted, made private, or is an old name from before collections had ids.
    // Checked when the URL is read, since picking another collection afterwards is not the link's doing.
    private bool requestedCollectionMissing;

    private SearchHit? SelectedHit => hits is not null && selected >= 0 && selected < hits.Count ? hits[selected] : null;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private ClaimsPrincipal user = new();

    protected override async Task OnInitializedAsync()
    {
        user = (await AuthenticationState).User;
        collections = await Documents.ListCollectionsAsync(user, CollectionAccess.Read);
        labels = collections.ToDictionary(c => c.Id, c => CollectionLabels.Name(c, collections, user));
        collectionNames = collections.Select(c => labels[c.Id]).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        query = Q ?? string.Empty;
        // Only ever one the viewer may read, whatever the URL asks for.
        collection = CollectionSelect.Pick(collections, CollectionParameter);
        requestedCollectionMissing = !string.IsNullOrEmpty(CollectionParameter)
            && !(Guid.TryParse(CollectionParameter, out var requestedId) && requestedId == collection?.Id);
        limit = LimitParameter is { } requested && SearchOptions.ResultPresets.Contains(requested) ? requested : SearchOptions.DefaultLimit;
        selectedTags = (TagParameter ?? []).ToHashSet();
        kind = Enum.TryParse<DocumentKind>(KindParameter, ignoreCase: true, out var requestedKind) && Enum.IsDefined(requestedKind)
            ? requestedKind
            : null;

        // Show the skeleton while tags load, rather than flashing the empty state before the search starts.
        busy = !string.IsNullOrWhiteSpace(query) && Navigation.Uri != lastSearchUri;

        if (collection?.Id != tagsCollection)
        {
            await LoadTagsAsync();
        }

        if (string.IsNullOrWhiteSpace(query))
        {
            hits = null;
            error = null;
            lastSearchUri = null;
            return;
        }

        if (collection is null)
        {
            hits = null;
            busy = false;
            error = "There's nothing you can search yet.";
            return;
        }

        // Prerendering would embed the query a second time; show the skeleton until the circuit is up.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (busy)
        {
            await RunSearchAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                selfReference = DotNetObjectReference.Create(this);
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Public/Search.razor.js");
                await module.InvokeVoidAsync("init", selfReference, searchBar!.Input);
            }

            if (revealPending && module is not null)
            {
                revealPending = false;
                await module.InvokeVoidAsync("revealSelected");
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away before the render finished.
        }
    }

    private async Task PickCollectionAsync(Guid id)
    {
        collection = collections.First(c => c.Id == id);
        await LoadTagsAsync();
    }

    private async Task LoadTagsAsync()
    {
        tagsCollection = collection?.Id;
        if (collection is null)
        {
            availableTags = [];
            return;
        }

        try
        {
            availableTags = (await Documents.ListTagsAsync(collection.Id)).Select(t => t.Name).ToList();
            selectedTags.IntersectWith(availableTags);
        }
        catch (Exception ex)
        {
            // Tags are optional; search still works without the filter.
            Log.LogWarning(ex, "Could not load tags for collection {CollectionId}", collection.Id);
            availableTags = [];
        }
    }

    private string SearchUri(string? q) => Navigation.GetUriWithQueryParameters(
        Navigation.BaseUri,
        new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(q) ? null : q.Trim(),
            ["collection"] = collection?.Id.ToString(),
            ["tag"] = selectedTags.Count > 0 ? selectedTags.Order().ToArray() : null,
            ["kind"] = kind?.ToString().ToLowerInvariant(),
            ["limit"] = limit == SearchOptions.DefaultLimit ? null : limit,
        });

    private void ToggleTag(string tag)
    {
        if (!selectedTags.Remove(tag))
        {
            selectedTags.Add(tag);
        }
    }

    private void ClearQuery()
    {
        query = string.Empty;
        error = null;
        filterError = null;
        Navigation.NavigateTo(SearchUri(null));
    }

    // Each search becomes a history entry; OnParametersSetAsync picks it up from the new URL.
    private async Task SubmitSearchAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        // Typing only filters sets them without searching.
        if (!await ApplyTypedFiltersAsync() || string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        var uri = SearchUri(query);
        if (uri == Navigation.Uri)
        {
            // Same URL, so no navigation would happen; searching again is still what was asked for.
            await RunSearchAsync();
            return;
        }

        Navigation.NavigateTo(uri);
    }

    // A finished in: switches collection straight away, so tag: goes on to suggest that collection's tags.
    private async Task OnQueryChangedAsync(string value)
    {
        query = value;
        if (SearchQuery.Draft(value)?.Key == SearchQuery.CollectionKey)
        {
            return;
        }

        if (SearchQuery.Parse(value).Collection is { } name && CollectionNamed(name) is { } named && named.Id != collection?.Id)
        {
            await PickCollectionAsync(named.Id);
        }
    }

    private CollectionSummary? CollectionNamed(string name) =>
        collections.FirstOrDefault(c => labels[c.Id].Equals(name, StringComparison.OrdinalIgnoreCase));

    // Moves tag: and in: out of the query into the filter controls, which the URL is built from.
    // A name that matches nothing leaves the query as typed, to be corrected.
    private async Task<bool> ApplyTypedFiltersAsync()
    {
        var parsed = SearchQuery.Parse(query);

        if (parsed.Collection is { } name)
        {
            var named = CollectionNamed(name);
            if (named is null)
            {
                filterError = $"There's no collection called '{name}'.";
                return false;
            }
            if (named.Id != collection?.Id)
            {
                await PickCollectionAsync(named.Id);
            }
        }

        var tags = new List<string>();
        foreach (var tag in parsed.Tags)
        {
            var known = availableTags.FirstOrDefault(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase));
            if (known is null)
            {
                filterError = $"There's no tag '{tag}' in this collection.";
                return false;
            }
            tags.Add(known);
        }

        selectedTags.UnionWith(tags);
        query = parsed.Text;
        filterError = null;
        return true;
    }

    private async Task RunSearchAsync()
    {
        lastSearchUri = Navigation.Uri;
        busy = true;
        error = null;
        hits = null;
        selected = -1;
        previewOpen = false;

        var timer = Stopwatch.StartNew();

        // The list was read when the page opened; the collection may have been made private or deleted since.
        if (!await Documents.CanAccessAsync(collection!.Id, user, CollectionAccess.Read))
        {
            error = "This collection is no longer available. Reload the page to see what you can search.";
            busy = false;
            return;
        }

        try
        {
            var tags = selectedTags.Order().ToList();
            var results = await Searcher.SearchAsync(collection.Id, query, tags, kind, limit);

            var queryTerms = SearchTerms.Of(query);
            terms = queryTerms.ToArray();
            snippets = results.Hits
                .Select(hit => SnippetBuilder.Build(MarkdownRenderer.ToPlainText(hit.Content), queryTerms))
                .ToList();
            hits = results.Hits;
            scoreKind = results.ScoreKind;
            citedCount = Assistant.Enabled ? Assistant.SourceCount(hits.Count) : 0;
            searchedQuery = query;
            searchedTags = tags;
            searchedKind = kind;
            searchedCollection = collection;
            elapsedMs = timer.ElapsedMilliseconds;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Search for {Query} in collection {CollectionId} failed", query, collection?.Id);
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }

        // The first hit is previewed straight away, but not opened as a sheet on narrow screens.
        if (hits is { Count: > 0 })
        {
            Select(0, open: false);
        }
    }

    private void Select(int index, bool open = true)
    {
        selected = index;
        previewOpen = open;
        revealPending = true;
        StateHasChanged();
    }

    // Returns false when there is nothing above to move to, so the keyboard can go back to the search box.
    [JSInvokable]
    public bool MoveSelection(int delta)
    {
        if (hits is not { Count: > 0 })
        {
            return false;
        }

        var next = Math.Max(selected, 0) + delta;
        if (next < 0)
        {
            return false;
        }

        Select(Math.Min(next, hits.Count - 1));
        return true;
    }

    [JSInvokable]
    public void ClosePreview()
    {
        previewOpen = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the page with it.
            }
        }

        selfReference?.Dispose();
    }
}

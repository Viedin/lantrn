@page "/documents/{Id:guid}"

@using Lantrn.Infra
@using Lantrn.Services

@inject DocumentStore Documents

<PageTitle>@(document?.Source ?? "Document")</PageTitle>

@if (document is null)
{
    <div class="alert alert-warning">
        This document no longer exists. It may have been removed.
    </div>
}
else
{
    <div class="page-heading">
        <span class="eyebrow">Document</span>
        <h1 class="text-break">@document.Source</h1>
        <p class="lead-text d-flex flex-wrap align-items-center gap-2">
            @if (canEdit)
            {
                <a class="metric-pill metric-pill-neutral text-decoration-none" href="collections/@collection!.Id">@collection.Name</a>
            }
            else
            {
                <span class="metric-pill metric-pill-neutral">@collection!.Name</span>
            }
            <span class="metric-pill metric-pill-neutral">@document.Markdown.Length.ToString("N0") chars</span>
            <span class="metric-pill metric-pill-neutral">@document.ChunkCount.ToString("N0") chunks</span>
            @if (document.Kind == DocumentKind.Ocr)
            {
                <span class="metric-pill" title="Text read from an image"><i class="bi bi-image" aria-hidden="true"></i> OCR</span>
            }
            <span>Ingested @document.IngestedAt.ToLocalTime().ToString("g")</span>
            @if (Uri.TryCreate(document.Source, UriKind.Absolute, out var url) && url.Scheme is "http" or "https")
            {
                <a href="@url" target="_blank" rel="noopener noreferrer">
                    Open original <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            }
            else if (document.OriginalFile is not null)
            {
                <a href="@OriginalHref" target="_blank">
                    Open original <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            }
        </p>
    </div>

    @if (canEdit)
    {
        <DocumentAdminBar @rendermode="InteractiveServer" DocumentId="Id" Source="@document.Source"
                          CollectionId="document.CollectionId" Tags="TagNames" />
    }
    else if (TagNames.Count > 0)
    {
        <p class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @foreach (var tag in TagNames)
            {
                <span class="metric-pill">@tag</span>
            }
        </p>
    }

    @if (document.Kind == DocumentKind.Ocr && document.OriginalFile is not null)
    {
        <div class="card card-panel mb-3">
            <div class="card-body text-center">
                <a href="@OriginalHref" target="_blank" title="Open the full-size image">
                    <img class="img-fluid rounded" style="max-height: 32rem;" src="@OriginalHref" alt="Original of @document.Source" />
                </a>
            </div>
        </div>
    }

    <div class="card card-panel">
        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <a class="btn btn-sm btn-outline-secondary" href="@(Raw ? SelfHref : $"{SelfHref}?raw=true")">
                    <i class="bi @(Raw ? "bi-file-richtext" : "bi-code-slash")" aria-hidden="true"></i>
                    @(Raw ? "Rendered" : "Raw markdown")
                </a>
            </div>

            <MarkdownView Text="@document.Markdown" Raw="Raw" />
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "raw")]
    public bool Raw { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private Document? document;
    private CollectionSummary? collection;
    private bool canEdit;

    private string SelfHref => $"documents/{Id}";

    private string OriginalHref => $"{SelfHref}/original";

    private IReadOnlyList<string> TagNames => document!.Tags.Select(t => t.Name).Order().ToList();

    // A document in a collection the viewer can't read shows as missing, like one that was removed.
    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationState).User;
        document = await Documents.GetAsync(Id);
        collection = document is null ? null : await Documents.GetCollectionAsync(document.CollectionId, user, CollectionAccess.Read);
        if (collection is null)
        {
            document = null;
        }
        canEdit = collection?.Allows(user, CollectionAccess.Contribute) == true;
    }
}

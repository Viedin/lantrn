@using Lantrn.Services

@* What each queued file or page turned into, chunk by chunk. *@
@if (Jobs.Count > 0)
{
    <div class="form-check d-flex justify-content-end gap-2 mb-2">
        <input id="raw" type="checkbox" class="form-check-input" @bind="showRaw" />
        <label class="form-check-label" for="raw">Raw markdown</label>
    </div>

    @foreach (var job in Jobs)
    {
        <details class="disclosure mb-3" @key="job.Id" open="@expanded.Contains(job.Id)">
            <summary @onclick="() => Toggle(job.Id)">
                @job.Request.Source
                <span class="metric-pill metric-pill-neutral ms-2">@job.Request.Collection</span>
                @switch (job.Status)
                {
                    case IngestJobStatus.Queued:
                        <span class="small ms-2">queued</span>
                        break;
                    case IngestJobStatus.Running:
                        <span class="spinner-border spinner-border-sm ms-2" aria-label="Running"></span>
                        break;
                    case IngestJobStatus.Done:
                        <span class="metric-pill ms-2">@(job.Result?.Chunks.Count ?? 0) chunks</span>
                        <a class="small ms-2" href="documents/@job.DocumentId">Open</a>
                        break;
                    case IngestJobStatus.Failed:
                        <span class="text-danger ms-2">failed</span>
                        break;
                    case IngestJobStatus.Cancelled:
                        <span class="small ms-2">stopped</span>
                        break;
                }
            </summary>

            @if (expanded.Contains(job.Id) && job.Error is not null)
            {
                <div class="alert alert-danger mt-3 mb-0">@job.Error</div>
            }
            else if (expanded.Contains(job.Id) && job.Result is { } result)
            {
                <div class="mt-3">
                    @foreach (var (chunk, index) in result.Chunks.Select((c, i) => (c, i)))
                    {
                        <div class="card result-card mb-2">
                            <div class="card-body">
                                <div class="result-meta">
                                    <span class="result-source">@(string.IsNullOrEmpty(chunk.HeadingPath) ? "(no heading)" : chunk.HeadingPath)</span>
                                    <span class="d-flex align-items-center gap-2">
                                        <span class="metric-pill metric-pill-neutral">#@index</span>
                                        <span class="metric-pill metric-pill-neutral">@chunk.Content.Length chars</span>
                                    </span>
                                </div>
                                <MarkdownView Text="@chunk.Content" Raw="showRaw" />
                            </div>
                        </div>
                    }

                    <details class="disclosure mt-3">
                        <summary>Full markdown</summary>
                        <div class="mt-3"><MarkdownView Text="@result.Markdown" Raw="showRaw" /></div>
                    </details>
                </div>
            }
        </details>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<IngestJob> Jobs { get; set; } = [];

    private bool showRaw;

    // Only open rows render their chunks, since the list re-renders on every step of the queue.
    private readonly HashSet<Guid> expanded = [];

    private void Toggle(Guid id)
    {
        if (!expanded.Remove(id))
        {
            expanded.Add(id);
        }
    }
}

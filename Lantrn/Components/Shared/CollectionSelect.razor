@using Lantrn.Services

<label class="form-label" for="@Id">Collection</label>
@if (Collections.Count == 0)
{
    <div class="form-control-plaintext">
        No collections yet. <a href="collections">Create one</a> first.
    </div>
}
else
{
    <select id="@Id" class="form-select" value="@Value?.Id.ToString()" @onchange="OnChangedAsync">
        @foreach (var collection in Collections)
        {
            <option value="@collection.Id">@labels[collection.Id]</option>
        }
    </select>
    <div class="form-text"><a href="collections">Manage collections</a></div>
}

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<CollectionSummary> Collections { get; set; } = [];

    [Parameter]
    public CollectionSummary? Value { get; set; }

    [Parameter]
    public EventCallback<CollectionSummary?> ValueChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private ClaimsPrincipal user = new();
    private Dictionary<Guid, string> labels = [];

    protected override async Task OnInitializedAsync() => user = (await AuthenticationState).User;

    protected override void OnParametersSet() =>
        labels = Collections.ToDictionary(c => c.Id, c => CollectionLabels.Name(c, Collections, user));

    // The requested collection (an id from the URL) when it is on offer, else whichever comes first.
    public static CollectionSummary? Pick(IReadOnlyList<CollectionSummary> collections, string? requested) =>
        (Guid.TryParse(requested, out var id) ? collections.FirstOrDefault(c => c.Id == id) : null)
            ?? collections.FirstOrDefault();

    // The posted value comes from the browser; only a collection on offer may be picked.
    private Task OnChangedAsync(ChangeEventArgs e) =>
        Guid.TryParse(e.Value?.ToString(), out var id) && Collections.FirstOrDefault(c => c.Id == id) is { } picked
            ? ValueChanged.InvokeAsync(picked)
            : Task.CompletedTask;
}

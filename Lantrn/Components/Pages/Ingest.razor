@page "/ingest"
@rendermode InteractiveServer

@using Lantrn.Services

@implements IAsyncDisposable

@inject IngestQueue Queue
@inject EmbeddingService Embeddings
@inject VisionOcrService Vision
@inject DocumentStore Documents
@inject IJSRuntime JS
@inject ILogger<Ingest> Log

<PageTitle>Ingest documents</PageTitle>

<div class="page-heading">
    <span class="eyebrow">Ingest</span>
    <h1>Ingest documents</h1>
    <p class="lead-text">
        Extract &rarr; markdown &rarr; chunk by section through Xberg, then embed. Files are queued and keep processing after you leave this page.
        @if (!string.IsNullOrEmpty(Embeddings.Model))
        {
            <text>Embedded with <code>@Embeddings.Model</code>.</text>
        }
    </p>
</div>

<div class="card card-panel mb-4">
    <div class="card-body">
        <div class="mb-3">
            <div class="drop-zone @(dragging ? "dragging" : null)"
                 @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false">
                <i class="bi bi-cloud-arrow-up fs-3" aria-hidden="true"></i>
                <span class="fw-semibold text-body-emphasis">
                    @(files.Count == 0 ? "Drop files here, click to choose, or paste a screenshot" : $"{files.Count} {(files.Count == 1 ? "file" : "files")} selected")
                </span>
                <span class="small">PDF, Word, PowerPoint, Excel, e-mail, e-books, text, HTML, images, or a ZIP of any of these</span>
                <InputFile @key="inputKey" id="documents" class="drop-zone-input" accept="@DocumentExtractor.AcceptAttribute"
                           multiple OnChange="OnFilesSelected" aria-label="Documents" />
            </div>
            <div class="form-text">Images are transcribed by @Vision.Model and the original image is kept alongside the text.</div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <CollectionSelect Id="collection" Collections="collections" @bind-Value="collection" />
            </div>
            <div class="col-md-8">
                <label class="form-label" for="tags">Tags</label>
                <input id="tags" class="form-control" @bind="tagsInput" placeholder="cs-docs, internal" />
                <div class="form-text">Comma separated. Applied to every file in this batch and usable as a search filter.</div>
            </div>
        </div>

        <details class="disclosure mb-3">
            <summary>Advanced settings</summary>
            <div class="row g-3">
                <ChunkingFields Options="options" />
            </div>
        </details>

        <button class="btn btn-primary" @onclick="QueueFilesAsync" disabled="@(files.Count == 0 || string.IsNullOrEmpty(collection) || uploading is not null)">
            @if (uploading is not null)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <text>Uploading @uploading</text>
            }
            else
            {
                <text>Ingest into @(string.IsNullOrEmpty(collection) ? "collection" : $"'{collection}'")</text>
            }
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<IngestActivity />

@code {
    private List<IBrowserFile> files = [];
    private string? error;
    private string? uploading;
    private bool dragging;
    // Changed to swap in a fresh file input once a batch is queued, which clears its selection.
    private int inputKey;
    private IJSObjectReference? pasteListener;
    private readonly CancellationTokenSource disposed = new();

    private string tagsInput = string.Empty;
    private readonly IngestOptions options = new();
    private IReadOnlyList<CollectionSummary> collections = [];
    private string collection = string.Empty;

    [SupplyParameterFromQuery(Name = "collection")]
    public string? CollectionParameter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        collections = await Documents.ListCollectionsAsync();
        collection = CollectionSelect.Pick(collections, CollectionParameter);
    }

    // Pasted images land in the file input, so they are picked like any chosen file.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Ingest.razor.js");
            pasteListener = await module.InvokeAsync<IJSObjectReference>("listenForPaste", "documents");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        error = null;
        dragging = false;

        var selected = e.GetMultipleFiles(e.FileCount);
        files = selected.Where(f => DocumentExtractor.TryGetContentType(f.Name, out _) || DocumentExtractor.IsArchive(f.Name)).ToList();

        var rejected = selected.Except(files).Select(f => f.Name).ToList();
        if (rejected.Count > 0)
        {
            error = $"Skipped unsupported files: {string.Join(", ", rejected)}. Supported: {string.Join(", ", DocumentExtractor.SupportedTypes.Keys)}, .zip.";
        }
    }

    // Blazor only re-renders an event handler at its first await and on completion,
    // so the upload loop calls this to show each file.
    private void ShowUploading(string fileName)
    {
        uploading = fileName;
        StateHasChanged();
    }

    private async Task QueueFilesAsync()
    {
        error = options.Validate();
        if (files.Count == 0 || string.IsNullOrEmpty(collection) || error is not null)
        {
            return;
        }

        var tags = DocumentStore.ParseTags(tagsInput);
        var failures = new List<string>();

        foreach (var file in files)
        {
            ShowUploading(file.Name);

            try
            {
                await using var stream = file.OpenReadStream(IngestQueue.MaxFileSize, disposed.Token);
                await Queue.EnqueueUploadAsync(new IngestRequest(collection, file.Name, file.Name, tags, options.Clone()), stream, disposed.Token);
            }
            catch (Exception ex) when (!disposed.IsCancellationRequested)
            {
                Log.LogError(ex, "Uploading {FileName} failed", file.Name);
                failures.Add($"{file.Name}: {ex.Message}");
            }
        }

        uploading = null;
        files = [];
        inputKey++;
        error = failures.Count > 0 ? $"Could not upload {string.Join("; ", failures)}" : null;
    }

    public async ValueTask DisposeAsync()
    {
        disposed.Cancel();
        disposed.Dispose();

        if (pasteListener is not null)
        {
            try
            {
                await pasteListener.InvokeVoidAsync("dispose");
                await pasteListener.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

@page "/crawl"
@rendermode InteractiveServer

@using Lantrn.Services

@implements IDisposable

@inject SourceStore Sources
@inject SourceSyncService Sync
@inject EmbeddingService Embeddings
@inject DocumentStore Documents
@inject ILogger<Crawl> Log

<PageTitle>Crawl a website</PageTitle>

<div class="page-heading">
    <span class="eyebrow">Ingest</span>
    <h1>Crawl a website</h1>
    <p class="lead-text">
        Follow links and the sitemap from a start URL, keep the pages under one path, and let Xberg strip navigation, headers and footers before chunking and embedding.
        @if (!string.IsNullOrEmpty(Embeddings.Model))
        {
            <text>Embedded with <code>@Embeddings.Model</code>.</text>
        }
    </p>
</div>

<div class="card card-panel mb-4">
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label class="form-label" for="url">Start URL</label>
                <input id="url" type="url" class="form-control" @bind="startUrl" @bind:after="OnStartUrlChanged" placeholder="https://openrouter.ai/docs/quickstart" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="scope">Only pages under</label>
                <input id="scope" class="form-control" @bind="scope" placeholder="/docs" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <CollectionSelect Id="collection" Collections="collections" @bind-Value="collection" />
            </div>
            <div class="col-md-5">
                <label class="form-label" for="tags">Tags</label>
                <input id="tags" class="form-control" @bind="tagsInput" placeholder="openrouter, docs" />
                <div class="form-text">Comma separated. Applied to every page in this crawl and usable as a search filter.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="schedule">Keep in sync</label>
                <select id="schedule" class="form-select" @bind="schedule">
                    <option value="@Schedule.Never">Never</option>
                    <option value="@Schedule.Daily">Daily</option>
                    <option value="@Schedule.Weekly">Weekly</option>
                </select>
                <div class="form-text">Re-crawls on schedule: changed pages are re-embedded, removed ones deleted.</div>
            </div>
        </div>

        <details class="disclosure mb-3">
            <summary>Advanced settings</summary>
            <div class="row g-3">
                <div class="col-sm">
                    <label class="form-label" for="max-pages">Max pages <InfoTip Text="@HelpText.MaxPages" /></label>
                    <input id="max-pages" type="number" class="form-control" @bind="maxPages" />
                </div>
                <ChunkingFields Options="options" />
            </div>
        </details>

        <button class="btn btn-primary" @onclick="CrawlAsync" disabled="@(!IsValidUrl || string.IsNullOrEmpty(collection))">
            Crawl into @(string.IsNullOrEmpty(collection) ? "collection" : $"'{collection}'")
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (websites.Count > 0)
{
    <h2 class="section-label mb-3">Websites</h2>
    <div class="card overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Website</th>
                        <th>Collection</th>
                        <th>Keep in sync</th>
                        <th>Last crawled</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in websites)
                    {
                        <tr @key="site.Id">
                            <td class="text-break">
                                <a class="fw-semibold text-body-emphasis" href="@site.Location" target="_blank" rel="noopener noreferrer">@site.Location</a>
                                @if (!string.IsNullOrEmpty(site.Scope) && site.Scope != "/")
                                {
                                    <span class="small"> under @site.Scope</span>
                                }
                            </td>
                            <td><a class="metric-pill metric-pill-neutral text-decoration-none" href="collections/@Uri.EscapeDataString(site.Collection)">@site.Collection</a></td>
                            <td>@ToSchedule(site.SyncInterval)</td>
                            <td>
                                @if (Sync.IsSyncing(site.Id))
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                    <span>Crawling…</span>
                                }
                                else
                                {
                                    <span title="@site.LastSyncedAt?.ToLocalTime().ToString("g")">@TimeText.Ago(site.LastSyncedAt)</span>
                                    @if (site.LastError is not null)
                                    {
                                        <div class="small text-danger">@site.LastError</div>
                                    }
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => Sync.SyncNow(site)" disabled="@Sync.IsSyncing(site.Id)">
                                    Crawl now
                                </button>
                                <button class="btn btn-sm btn-link" title="Stop keeping this site in sync. Its pages stay in the collection." @onclick="() => RemoveAsync(site)">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<IngestActivity />

@code {
    private enum Schedule
    {
        Never,
        Daily,
        Weekly,
    }

    private string? error;
    private string startUrl = string.Empty;
    private string scope = string.Empty;
    private string tagsInput = string.Empty;
    private int maxPages = 100;
    private Schedule schedule = Schedule.Never;
    private readonly IngestOptions options = new();
    private IReadOnlyList<CollectionSummary> collections = [];
    private string collection = string.Empty;
    private IReadOnlyList<Source> websites = [];

    [SupplyParameterFromQuery(Name = "collection")]
    public string? CollectionParameter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Sync.Changed += OnSyncChanged;
        collections = await Documents.ListCollectionsAsync();
        collection = CollectionSelect.Pick(collections, CollectionParameter);
        await LoadWebsitesAsync();
    }

    private bool IsValidUrl =>
        Uri.TryCreate(startUrl, UriKind.Absolute, out var url) && url.Scheme is "http" or "https";

    // "https://openrouter.ai/docs/quickstart" pre-fills "/docs" unless a prefix was already typed.
    private void OnStartUrlChanged()
    {
        if (string.IsNullOrWhiteSpace(scope) && Uri.TryCreate(startUrl, UriKind.Absolute, out var url))
        {
            scope = WebCrawler.DefaultScope(url);
        }
    }

    // The crawl itself runs in the background, so it carries on when this page is closed.
    private async Task CrawlAsync()
    {
        error = maxPages <= 0 ? "Max pages must be positive." : options.Validate();
        if (!IsValidUrl || string.IsNullOrEmpty(collection) || error is not null)
        {
            return;
        }

        var start = new Uri(startUrl);
        var prefix = string.IsNullOrWhiteSpace(scope) ? WebCrawler.DefaultScope(start) : scope;

        try
        {
            var site = await Sources.SaveWebsiteAsync(
                collection, start, prefix, maxPages, DocumentStore.ParseTags(tagsInput), options, ToInterval(schedule));
            Sync.SyncNow(site);
            await LoadWebsitesAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving the crawl of {Start} failed", start);
            error = ex.Message;
        }
    }

    private async Task RemoveAsync(Source site)
    {
        await Sources.RemoveAsync(site.Id);
        await LoadWebsitesAsync();
    }

    private async Task LoadWebsitesAsync() =>
        websites = (await Sources.ListAsync()).Where(s => s.Kind == SourceKind.Website).ToList();

    private void OnSyncChanged() => _ = InvokeAsync(async () =>
    {
        await LoadWebsitesAsync();
        StateHasChanged();
    });

    private static TimeSpan? ToInterval(Schedule schedule) => schedule switch
    {
        Schedule.Daily => TimeSpan.FromDays(1),
        Schedule.Weekly => TimeSpan.FromDays(7),
        _ => null,
    };

    private static string ToSchedule(TimeSpan? interval) =>
        interval is null ? "Never" : interval == TimeSpan.FromDays(1) ? "Daily" : interval == TimeSpan.FromDays(7) ? "Weekly" : $"Every {interval}";

    public void Dispose() => Sync.Changed -= OnSyncChanged;
}

@page "/collections/{Id:guid}"
@rendermode InteractiveServer

@using Lantrn.Infra
@using Lantrn.Services

@inject DocumentStore Documents
@inject IngestQueue Queue
@inject EmbeddingService Embeddings
@inject ILogger<CollectionView> Log

<PageTitle>@(collection?.Name ?? "Collection")</PageTitle>

@if (loading)
{
    <div class="d-flex align-items-center gap-2">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Loading collection…</span>
    </div>
}
else if (collection is null)
{
    <div class="alert alert-warning">This collection doesn't exist, or it's private.</div>
}
else
{
    <div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3">
        <div>
            <span class="eyebrow">Collection</span>
            <h1 class="text-break">@collection.Name</h1>
            <p class="lead-text d-flex flex-wrap align-items-center gap-2">
                @if (collection.Description is not null)
                {
                    <span>@collection.Description</span>
                }
                <span class="metric-pill metric-pill-neutral">@collection.DocumentCount.ToString("N0") documents</span>
                <span class="metric-pill metric-pill-neutral">@collection.ChunkCount.ToString("N0") chunks</span>
                <span class="metric-pill metric-pill-neutral">Owner: @CollectionLabels.Owner(collection, user)</span>
                @if (!canManage)
                {
                    <VisibilityPill IsPrivate="collection.IsPrivate" />
                }
            </p>
            @if (canManage)
            {
                <div class="form-check form-switch">
                    <input id="private" type="checkbox" role="switch" class="form-check-input"
                           checked="@collection.IsPrivate" disabled="@busy" @onchange="SetPrivateAsync" />
                    <label class="form-check-label" for="private">
                        @(collection.IsPrivate
                            ? "Private: only the owner and the admins can search it"
                            : "Public: everyone who can search sees it, and every user can add and remove documents")
                    </label>
                </div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="./?collection=@Id">
                <i class="bi bi-search" aria-hidden="true"></i> Search
            </a>
            <a class="btn btn-outline-primary" href="ingest?collection=@Id">
                <i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i> Add files
            </a>
            <a class="btn btn-outline-primary" href="crawl?collection=@Id">
                <i class="bi bi-globe2" aria-hidden="true"></i> Crawl a site
            </a>
            @if (canManage)
            {
                <button class="btn btn-outline-primary" @onclick="() => confirmReembed = true" disabled="@(collection.DocumentCount == 0)"
                        title="Embed every document again, such as after switching embedding models">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Re-embed
                </button>
            }
        </div>
    </div>

    @* The documents folder only syncs into collections the admins manage. *@
    @if (isAdmin && collection.OwnerId is null)
    {
        <div class="alert alert-info">
            Files placed in <code>@(Id == Collection.DefaultId ? Documents.FolderPath : Path.Combine(Documents.FolderPath, collection.Name))</code>
            are added to this collection automatically and re-embedded when they change.
        </div>
    }

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (reembedQueued)
    {
        <div class="alert alert-success">
            Every document in '@collection.Name' is queued to be embedded again. Search in it is incomplete until they are done.
            <a href="ingest">See progress</a>
        </div>
    }

    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <input class="form-control" style="max-width: 20rem;" @bind="sourceFilter" @bind:event="oninput" @bind:after="LoadDocumentsAsync"
               placeholder="Filter by name or URL…" aria-label="Filter documents" />

        @if (tags.Count > 0)
        {
            <div class="tag-chips" role="group" aria-label="Filter by tag">
                @foreach (var tag in tags)
                {
                    var active = selectedTag == tag.Name;
                    <button type="button" class="tag-chip @(active ? "active" : null)"
                            aria-pressed="@(active ? "true" : "false")" @onclick="() => ToggleTagAsync(tag.Name)">
                        @tag.Name <span class="tag-count">@tag.Documents</span>
                    </button>
                }
            </div>
        }

        @if (selected.Count > 0)
        {
            <div class="d-flex align-items-center gap-2 ms-auto">
                <span class="small">@selected.Count.ToString("N0") selected</span>
                <button class="btn btn-sm btn-link" @onclick="() => selected.Clear()">Clear</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteSelected = true">
                    <i class="bi bi-trash" aria-hidden="true"></i> Delete selected
                </button>
            </div>
        }
    </div>

    @if (documents.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
            @if (selectedTag is null && string.IsNullOrWhiteSpace(sourceFilter))
            {
                <h2>Nothing indexed yet</h2>
                <p>Add files or crawl a site into this collection to make it searchable.</p>
            }
            else
            {
                <h2>No matching documents</h2>
                <p>Clear the filter or pick another tag.</p>
            }
        </div>
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" class="form-check-input" checked="@AllSelected"
                                       @onchange="e => SelectAll((bool)e.Value!)" aria-label="Select all shown documents" />
                            </th>
                            <th>Document</th>
                            <th>Tags</th>
                            <th class="text-end">Chunks</th>
                            <th>Ingested</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in documents)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@selected.Contains(document.Id)"
                                           @onchange="e => Select(document.Id, (bool)e.Value!)" aria-label="Select @document.Source" />
                                </td>
                                <td>
                                    <a class="fw-semibold text-body-emphasis text-break" href="documents/@document.Id">@document.Source</a>
                                    <div class="small">
                                        @document.Characters.ToString("N0") chars
                                        @if (document.Kind == DocumentKind.Ocr)
                                        {
                                            <span class="metric-pill ms-1" title="Text read from an image"><i class="bi bi-image" aria-hidden="true"></i> OCR</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (editingId == document.Id)
                                    {
                                        <div class="d-flex gap-2">
                                            <TagInput Tags="document.Tags" Busy="busy" OnSave="tags => SaveTagsAsync(document.Id, tags)"
                                                      OnCancel="() => editingId = null" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var tag in document.Tags)
                                            {
                                                <span class="metric-pill metric-pill-neutral">@tag</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-end">@document.ChunkCount.ToString("N0")</td>
                                <td>@document.IngestedAt.ToLocalTime().ToString("g")</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => editingId = document.Id"
                                            title="Edit tags" aria-label="Edit tags of @document.Source">
                                        <i class="bi bi-tags" aria-hidden="true"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = document"
                                            title="Delete document" aria-label="Delete @document.Source">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <DeleteConfirmModal Show="@(pendingDelete is not null)" Busy="busy" Title="Delete document?"
                         OnConfirm="DeleteAsync" OnCancel="() => pendingDelete = null">
        Remove <strong>@pendingDelete?.Source</strong> and its vectors? This can't be undone.
    </DeleteConfirmModal>

    <DeleteConfirmModal Show="confirmDeleteSelected" Busy="busy" Title="@($"Delete {selected.Count:N0} documents?")"
                         OnConfirm="DeleteSelectedAsync" OnCancel="() => confirmDeleteSelected = false">
        @if (busy)
        {
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            <text>Deleted @deletedCount.ToString("N0") of @selected.Count.ToString("N0")…</text>
        }
        else
        {
            <text>Remove the @selected.Count.ToString("N0") selected documents and their vectors from <strong>@collection.Name</strong>? This can't be undone.</text>
        }
    </DeleteConfirmModal>

    <DeleteConfirmModal Show="confirmReembed" Busy="busy" Title="Re-embed collection?" ConfirmText="Re-embed"
                         OnConfirm="ReembedAsync" OnCancel="() => confirmReembed = false">
        <p>
            Chunk and embed all @collection.DocumentCount.ToString("N0") documents in <strong>@collection.Name</strong> again with
            <code>@Embeddings.Model</code>, using the default chunking. Use this after switching embedding models.
        </p>
        <p class="mb-0">
            Nothing needs uploading again, and images aren't read again by the vision model.
            The current vectors are removed first, so search in this collection is incomplete until it is done.
        </p>
    </DeleteConfirmModal>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private ClaimsPrincipal user = new();
    private bool isAdmin;
    private bool canManage;
    private CollectionSummary? collection;
    private IReadOnlyList<DocumentSummary> documents = [];
    private IReadOnlyList<TagCount> tags = [];
    private string? selectedTag;
    private string sourceFilter = string.Empty;
    private bool loading = true;
    private bool busy;
    private string? error;

    private Guid? editingId;
    private DocumentSummary? pendingDelete;
    private bool confirmReembed;
    private bool reembedQueued;

    private readonly HashSet<Guid> selected = [];
    private bool confirmDeleteSelected;
    private int deletedCount;

    private bool AllSelected => documents.Count > 0 && documents.All(d => selected.Contains(d.Id));

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        selectedTag = null;
        sourceFilter = string.Empty;

        user = (await AuthenticationState).User;
        isAdmin = user.IsInRole(Roles.Admin);
        collection = await Documents.GetCollectionAsync(Id, user, CollectionAccess.Contribute);
        canManage = collection?.Allows(user, CollectionAccess.Manage) == true;
        if (collection is not null)
        {
            await LoadTagsAsync();
            await LoadDocumentsAsync();
        }

        loading = false;
    }

    // A selection only ever holds shown documents, so a filter change can't leave hidden ones to be deleted.
    private async Task LoadDocumentsAsync()
    {
        documents = await Documents.ListDocumentsAsync(Id, selectedTag, sourceFilter);
        selected.IntersectWith(documents.Select(d => d.Id));
    }

    private void Select(Guid id, bool isSelected)
    {
        if (isSelected)
        {
            selected.Add(id);
        }
        else
        {
            selected.Remove(id);
        }
    }

    private void SelectAll(bool isSelected)
    {
        if (isSelected)
        {
            selected.UnionWith(documents.Select(d => d.Id));
        }
        else
        {
            selected.Clear();
        }
    }

    private async Task LoadTagsAsync()
    {
        tags = await Documents.ListTagsAsync(Id);
        if (selectedTag is not null && tags.All(t => t.Name != selectedTag))
        {
            selectedTag = null;
        }
    }

    private async Task ReloadAsync()
    {
        collection = await Documents.GetCollectionAsync(Id, user, CollectionAccess.Contribute);
        await LoadTagsAsync();
        await LoadDocumentsAsync();
    }

    private async Task SetPrivateAsync(ChangeEventArgs e)
    {
        if (!await StillAllowedAsync(CollectionAccess.Manage))
        {
            return;
        }

        busy = true;
        error = null;

        try
        {
            await Documents.SetVisibilityAsync(Id, (bool)e.Value!);
            collection = await Documents.GetCollectionAsync(Id, user, CollectionAccess.Contribute);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Changing the visibility of collection {CollectionId} failed", Id);
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ToggleTagAsync(string tag)
    {
        selectedTag = selectedTag == tag ? null : tag;
        await LoadDocumentsAsync();
    }

    private async Task SaveTagsAsync(Guid id, IReadOnlyList<string> newTags)
    {
        await RunAsync(async () =>
        {
            await Documents.SetTagsAsync(id, newTags);
            editingId = null;
        }, "Retagging document {DocumentId} failed", id);
    }

    private async Task DeleteAsync()
    {
        var id = pendingDelete!.Id;
        await RunAsync(() => Documents.DeleteAsync(id), "Deleting document {DocumentId} failed", id);
        pendingDelete = null;
    }

    private async Task DeleteSelectedAsync()
    {
        if (!await StillAllowedAsync(CollectionAccess.Contribute))
        {
            return;
        }

        busy = true;
        error = null;
        deletedCount = 0;

        try
        {
            foreach (var id in selected.ToList())
            {
                await Documents.DeleteAsync(id);
                deletedCount++;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting the selected documents from collection {CollectionId} failed", Id);
            error = $"Deleted {deletedCount:N0} of {selected.Count:N0} documents, then: {ex.Message}";
        }
        finally
        {
            await ReloadAsync();
            confirmDeleteSelected = false;
            busy = false;
        }
    }

    // A collection's vectors all have one size, so they are dropped together and rebuilt from the stored documents.
    private async Task ReembedAsync()
    {
        if (!await StillAllowedAsync(CollectionAccess.Manage))
        {
            return;
        }

        busy = true;
        error = null;

        try
        {
            await Documents.DeleteVectorsAsync(Id);
            foreach (var document in await Documents.ListDocumentsAsync(Id))
            {
                await Queue.EnqueueReembedAsync(Id, document.Id, document.Source);
            }
            reembedQueued = true;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Queueing the re-embed of collection {CollectionId} failed", Id);
            error = ex.Message;
        }
        finally
        {
            confirmReembed = false;
            busy = false;
        }
    }

    // Access was checked when the page opened; since then the collection may have been made private or deleted.
    // Losing it falls back to the page's "doesn't exist" state.
    private async Task<bool> StillAllowedAsync(CollectionAccess access)
    {
        if (await Documents.CanAccessAsync(Id, user, access))
        {
            return true;
        }

        collection = null;
        return false;
    }

    private async Task RunAsync(Func<Task> action, string failureMessage, Guid id)
    {
        if (!await StillAllowedAsync(CollectionAccess.Contribute))
        {
            return;
        }

        busy = true;
        error = null;

        try
        {
            await action();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, failureMessage, id);
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
